---
import SiteLayout from "../layouts/SiteLayout.astro";

const boardMembers = [
	{ role: "Vorsitzender", name: "Simon Blessinger" },
	{ role: "Stellvertretender Vorsitzender", name: "Emanuel Rassel" },
	{ role: "Kassenwart", name: "Nico Hoffmann" },
	{ role: "Pressewart", name: "Valentin Reinhard" },
];
const sponsorSlots = Array.from({ length: 9 }, (_, index) => index + 1);
---

<SiteLayout
	title="Verein"
	description="Lerne Ausdauerwerk e.V. kennen und erfahre mehr über unseren Vorstand."
>
	<div class="content">
		<section class="introduction" aria-labelledby="verein-title">
			<p class="eyebrow">Ausdauerwerk e.V.</p>
			<h1 id="verein-title">
				Sport verbindet.<br /><span>Ausdauer auch.</span>
			</h1>
			<p class="intro-copy">
				Wir sind ein Ausdauersportverein mit dem Fahrrad im Mittelpunkt. Unsere Mitglieder sind
				weit verstreut – verbunden durch die Freude am Radfahren und die Gemeinschaft im Verein.
			</p>
		</section>

		<section class="board" aria-labelledby="board-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Die Menschen dahinter</p>
					<h2 id="board-title">Unser Vorstand</h2>
				</div>
				<p>Fotos und weitere Informationen folgen.</p>
			</div>
			<div class="board-grid">
				{boardMembers.map(({ role, name }) => (
					<article class="board-card">
						<div class="photo-placeholder" role="img" aria-label={`Platzhalter für Foto von ${name}`}>
							<span aria-hidden="true">+</span>
							<small>Foto folgt</small>
						</div>
						<div class="board-caption">
							<strong>{name}</strong>
							<span>{role}</span>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="history" aria-labelledby="history-title">
			<p class="eyebrow">Wie alles begann</p>
			<h2 id="history-title">Unsere Geschichte</h2>
			<p>
				Hier folgt die Geschichte des Ausdauerwerk e.V. – von der Gründung bis heute.
			</p>
		</section>

		<section class="sponsors" aria-labelledby="sponsors-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Danke für eure Unterstützung</p>
					<h2 id="sponsors-title">Unsere Sponsoren</h2>
				</div>
			</div>
			<div class="sponsors-wall" role="list" aria-label="Platzhalter für die Sponsorenlogos">
				{sponsorSlots.map((slot) => (
					<div class="sponsor-tile" role="listitem" aria-label={`Sponsorlogo ${slot} folgt`}>
						<span aria-hidden="true">+</span>
						<small>Logo folgt</small>
					</div>
				))}
			</div>
		</section>
	</div>
</SiteLayout>

<style>
	.content {
		width: min(1120px, calc(100% - 3rem));
		margin: 0 auto;
	}

	.introduction {
		max-width: 800px;
		padding: clamp(4rem, 9vw, 7rem) 0 4.5rem;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: #1f7284;
		font-size: 0.75rem;
		font-weight: 750;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1,
	h2,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 1.4rem;
		color: #252b37;
		font-size: clamp(2.8rem, 6vw, 5rem);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.065em;
	}

	h1 span {
		color: #1f7284;
	}

	.intro-copy {
		max-width: 670px;
		margin-bottom: 0;
		color: #515967;
		font-size: clamp(1rem, 1.8vw, 1.16rem);
		line-height: 1.75;
	}

	.board {
		padding: 2rem 0 2.5rem;
	}

	.sponsors {
		padding: 1rem 0 6rem;
	}

	.history {
		max-width: 760px;
		padding: 2rem 0;
	}

	.history h2 {
		margin-bottom: 0.9rem;
	}

	.history p:last-child {
		margin-bottom: 0;
		color: #515967;
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.section-heading {
		display: flex;
		margin-bottom: 1.7rem;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
	}

	h2 {
		margin-bottom: 0;
		color: #252b37;
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.055em;
	}

	.section-heading > p {
		margin-bottom: 0.25rem;
		color: #65707c;
		font-size: 0.92rem;
	}

	.board-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}

	.board-card {
		min-width: 0;
	}

	.photo-placeholder {
		display: flex;
		min-height: 180px;
		aspect-ratio: 4 / 5;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 0.5rem;
		color: #1f7284;
		background:
			linear-gradient(145deg, rgb(255 255 255 / 54%), transparent 58%),
			#dce8e7;
		border: 1px dashed rgb(31 114 132 / 42%);
		border-radius: 0.2rem;
	}

	.photo-placeholder > span {
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border: 1px solid currentColor;
		border-radius: 50%;
		font-size: 1.5rem;
		font-weight: 300;
	}

	.photo-placeholder small {
		font-size: 0.76rem;
		font-weight: 650;
	}

	.board-caption {
		display: grid;
		gap: 0.25rem;
		padding: 0.9rem 0.1rem;
	}

	.board-caption strong {
		color: #252b37;
		font-size: 0.94rem;
	}

	.board-caption span {
		color: #65707c;
		font-size: 0.8rem;
	}

	.sponsors-wall {
		display: grid;
		padding: 1rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		background: #e8edec;
		border-radius: 0.2rem;
	}

	.sponsor-tile {
		display: flex;
		min-height: 120px;
		padding: 1rem;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 0.45rem;
		color: #1f7284;
		background: #fff;
		border: 1px solid #dce2e1;
		border-radius: 0.2rem;
		box-shadow: 0 2px 6px rgb(37 43 55 / 5%);
	}

	.sponsor-tile > span {
		display: grid;
		width: 34px;
		height: 34px;
		place-items: center;
		border: 1px dashed currentColor;
		border-radius: 50%;
		font-size: 1.25rem;
		font-weight: 300;
	}

	.sponsor-tile small {
		color: #65707c;
		font-size: 0.76rem;
		font-weight: 650;
	}

	@media (max-width: 760px) {
		.content {
			width: calc(100% - 2rem);
		}

		.introduction {
			padding-bottom: 3rem;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.7rem;
		}

		.board {
			padding-top: 1rem;
			padding-bottom: 1.5rem;
		}

		.sponsors {
			padding-top: 1rem;
			padding-bottom: 4rem;
		}

		.sponsors-wall {
			padding: 0.65rem;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.55rem;
		}

		.sponsor-tile {
			min-height: 100px;
		}

		.history {
			padding: 1.5rem 0;
		}

		.board-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}

		.photo-placeholder {
			min-height: 145px;
		}
	}
</style>
