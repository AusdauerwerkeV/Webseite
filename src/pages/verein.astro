---
import SiteLayout from "../layouts/SiteLayout.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const boardMembers = [
	{ role: "Vorsitzender", name: "Simon Blessinger", image: null },
	{ role: "Stellvertretender Vorsitzender", name: "Emanuel Rassel", image: null },
	{
		role: "Kassenwart",
		name: "Nico Hoffmann",
		image: `${baseUrl}images/board/nico.jpg`,
	},
	{
		role: "Pressewart",
		name: "Valentin Reinhard",
		image: `${baseUrl}images/board/valentin.jpg`,
	},
];
const sponsors = [
	{ name: "CURREX", image: `${baseUrl}images/sponsors/currex.png` },
	{ name: "Di Carlo Museo & Vino di Maranello", image: `${baseUrl}images/sponsors/di-carlo.jpg` },
	{ name: "Dürr & Feil Builtech Group", image: `${baseUrl}images/sponsors/duerr-feil.png` },
	{ name: "Klout Design & Werbetechnik", image: `${baseUrl}images/sponsors/klout.svg` },
	{ name: "WKS Haustechnik", image: `${baseUrl}images/sponsors/wks-haustechnik.jpg` },
	{ name: "ESW Luft- und Klimatechnik", image: `${baseUrl}images/sponsors/esw.png` },
	{ name: "IGH Ingenieurgesellschaften", image: `${baseUrl}images/sponsors/igh.png` },
	{ name: "Tour Ginkgo – Rollt für kranke Kinder", image: `${baseUrl}images/sponsors/tourginkgo.png` },
];
---

<SiteLayout
	title="Verein"
	description="Lerne Ausdauerwerk e.V. kennen und erfahre mehr über unseren Vorstand."
>
	<div class="content">
		<section class="introduction" aria-labelledby="verein-title">
			<p class="eyebrow">Ausdauerwerk e.V.</p>
			<h1 id="verein-title">
				Sport verbindet.<br /><span>Ausdauer auch.</span>
			</h1>
			<p class="intro-copy">
				Wir sind ein Ausdauersportverein mit dem Fahrrad im Mittelpunkt. Unsere Mitglieder sind
				weit verstreut – verbunden durch die Freude am Radfahren und die Gemeinschaft im Verein.
			</p>
		</section>

		<section class="board" aria-labelledby="board-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Die Menschen dahinter</p>
					<h2 id="board-title">Unser Vorstand</h2>
				</div>
				<p>Weitere Fotos und Informationen folgen.</p>
			</div>
			<div class="board-grid">
				{boardMembers.map(({ role, name, image }) => (
					<article class="board-card">
						{image ? (
							<img
								class="board-photo"
								src={image}
								alt={`Foto von ${name}`}
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div
								class="photo-placeholder"
								role="img"
								aria-label={`Platzhalter für Foto von ${name}`}
							>
								<span aria-hidden="true">+</span>
								<small>Foto folgt</small>
							</div>
						)}
						<div class="board-caption">
							<strong>{name}</strong>
							<span>{role}</span>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="history" aria-labelledby="history-title">
			<p class="eyebrow">Wie alles begann</p>
			<h2 id="history-title">Von einer Idee zu einer Gemeinschaft.</h2>
			<p>
				Alles begann mit einem großen Ziel: Rad am Ring 2026. Aus der Idee, dieses besondere
				Rennen gemeinsam zu bestreiten, entstand schnell eine größere Vision. Am 4. Januar 2026
				wurde daraus der Ausdauerwerk e.V. – ein Verein, der weit mehr sein sollte als ein
				gemeinsames Rennen.
			</p>
			<p>
				Schon im April ging es ins erste gemeinsame Trainingslager nach Mallorca. Neben vielen
				Kilometern gehörte auch ein Fotoshooting dazu, das unserem jungen Verein erstmals ein
				gemeinsames Gesicht gab. Im Mai folgte ein Kennenlernwochenende im Allgäu, bei dem
				Gemeinschaft, gemeinsame Pläne und natürlich das große Ziel im Mittelpunkt standen.
			</p>
			<p>
				Im Juli war es dann so weit: Rad am Ring auf der Nürburgring-Nordschleife. Das Rennen,
				mit dem alles begonnen hatte, wurde zum gemeinsamen Höhepunkt des Sommers. Doch dabei
				blieb es nicht. Weitere Rennen, gemeinsame Kilometer und neue Erlebnisse folgten.
			</p>
			<p>
				Anfang November schloss sich schließlich der Kreis: Bei unserer Filmpremiere blickten wir
				gemeinsam auf unser erstes Vereinsjahr zurück und teilten unsere Geschichte mit Freunden,
				Unterstützern und der Öffentlichkeit.
			</p>
			<p>
				Aus einem Rennen wurde ein Verein. Aus einer Idee eine Gemeinschaft. Und unsere Geschichte
				hat gerade erst begonnen.
			</p>
		</section>

		<section class="sponsors" aria-labelledby="sponsors-title">
			<div class="section-heading">
				<div>
					<h2 id="sponsors-title">Unsere Unterstützer</h2>
					<p class="eyebrow">Danke für eure Unterstützung</p>
				</div>
			</div>
			<div class="sponsors-wall" role="list" aria-label="Sponsorenlogos">
				{sponsors.map(({ name, image }) => (
					<div class="sponsor-tile" role="listitem">
						<img src={image} alt={name} loading="lazy" decoding="async" />
					</div>
				))}
			</div>
		</section>
	</div>
</SiteLayout>

<style>
	.content {
		width: min(1120px, calc(100% - 3rem));
		margin: 0 auto;
	}

	.introduction {
		max-width: 800px;
		padding: clamp(4rem, 9vw, 7rem) 0 4.5rem;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: #1f7284;
		font-size: 0.75rem;
		font-weight: 750;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1,
	h2,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 1.4rem;
		color: #252b37;
		font-size: clamp(2.8rem, 6vw, 5rem);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.065em;
	}

	h1 span {
		color: #1f7284;
	}

	.intro-copy {
		max-width: 670px;
		margin-bottom: 0;
		color: #515967;
		font-size: clamp(1rem, 1.8vw, 1.16rem);
		line-height: 1.75;
	}

	.board {
		padding: 2rem 0 2.5rem;
	}

	.sponsors {
		padding: 1rem 0 6rem;
	}

	.history {
		max-width: 760px;
		padding: 2rem 0;
	}

	.history h2 {
		margin-bottom: 0.9rem;
	}

	.history p:last-child {
		margin-bottom: 0;
		color: #515967;
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.section-heading {
		display: flex;
		margin-bottom: 1.7rem;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
	}

	h2 {
		margin-bottom: 0;
		color: #252b37;
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.055em;
	}

	.section-heading > p {
		margin-bottom: 0.25rem;
		color: #65707c;
		font-size: 0.92rem;
	}

	.board-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}

	.board-card {
		min-width: 0;
	}

	.photo-placeholder {
		display: flex;
		min-height: 180px;
		aspect-ratio: 4 / 5;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 0.5rem;
		color: #1f7284;
		background:
			linear-gradient(145deg, rgb(255 255 255 / 54%), transparent 58%),
			#dce8e7;
		border: 1px dashed rgb(31 114 132 / 42%);
		border-radius: 0.2rem;
	}

	.board-photo {
		display: block;
		width: 100%;
		min-height: 180px;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center;
		border-radius: 0.2rem;
	}

	.photo-placeholder > span {
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border: 1px solid currentColor;
		border-radius: 50%;
		font-size: 1.5rem;
		font-weight: 300;
	}

	.photo-placeholder small {
		font-size: 0.76rem;
		font-weight: 650;
	}

	.board-caption {
		display: grid;
		gap: 0.25rem;
		padding: 0.9rem 0.1rem;
	}

	.board-caption strong {
		color: #252b37;
		font-size: 0.94rem;
	}

	.board-caption span {
		color: #65707c;
		font-size: 0.8rem;
	}

	.sponsors-wall {
		display: grid;
		padding: 1rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		background: #e8edec;
		border-radius: 0.2rem;
	}

	.sponsor-tile {
		display: flex;
		min-height: 150px;
		padding: 1rem;
		align-items: center;
		justify-content: center;
		background: #fff;
		border: 1px solid #dce2e1;
		border-radius: 0.2rem;
		box-shadow: 0 2px 6px rgb(37 43 55 / 5%);
	}

	.sponsor-tile img {
		display: block;
		width: 100%;
		max-height: 105px;
		object-fit: contain;
	}

	@media (max-width: 760px) {
		.content {
			width: calc(100% - 2rem);
		}

		.introduction {
			padding-bottom: 3rem;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.7rem;
		}

		.board {
			padding-top: 1rem;
			padding-bottom: 1.5rem;
		}

		.sponsors {
			padding-top: 1rem;
			padding-bottom: 4rem;
		}

		.sponsors-wall {
			padding: 0.65rem;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.55rem;
		}

		.sponsor-tile {
			min-height: 120px;
			padding: 0.75rem;
		}

		.history {
			padding: 1.5rem 0;
		}

		.board-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}

		.photo-placeholder,
		.board-photo {
			min-height: 145px;
		}
	}
</style>
