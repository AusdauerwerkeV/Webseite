---
import SiteLayout from "../layouts/SiteLayout.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const withBase = (url: string) => `${baseUrl}${url.replace(/^\/+/, "")}`;
---

<SiteLayout
	title="Zusammen mehr Strecke machen"
	description="Ausdauerwerk e.V. – gemeinsam auf dem Rad unterwegs."
>
	<section class="hero" aria-labelledby="hero-title">
		<img
			class="hero-image"
			src={withBase("/images/ausdauerwerk-hero.jpg")}
			alt=""
			aria-hidden="true"
			fetchpriority="high"
		/>
		<video
			class="hero-video"
			autoplay
			muted
			playsinline
			loop
			preload="auto"
			aria-label="Filmsequenz des Ausdauerwerk e.V."
		>
			<source src={withBase("/videos/startsequenz.mp4")} type="video/mp4" />
		</video>
		<div class="hero-copy">
			<p class="hero-eyebrow">Ausdauerwerk e.V.</p>
			<h1 id="hero-title">Zusammen mehr<br />Strecke machen.</h1>
		</div>
		<div class="hero-brand">
			<img src={withBase("/images/ausdauerwerk-icon-wht.png")} alt="Ausdauerwerk-Signet" />
		</div>
	</section>
</SiteLayout>

<style>
	.hero {
		position: relative;
		display: flex;
		min-height: min(760px, max(540px, calc(100svh - 164px)));
		overflow: hidden;
		align-items: flex-end;
		background: #252b37;
		isolation: isolate;
	}

	.hero::before {
		position: absolute;
		z-index: -1;
		background: linear-gradient(
			90deg,
			#252b37 0%,
			#252b37 28%,
			rgb(37 43 55 / 78%) 40%,
			rgb(37 43 55 / 38%) 56%,
			rgb(37 43 55 / 8%) 75%,
			transparent 100%
		);
		content: "";
		inset: 0;
	}

	.hero-image,
	.hero-video {
		position: absolute;
		z-index: -2;
		top: 0;
		right: 0;
		width: 68%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
	}

	.hero-image {
		display: none;
	}

	.hero-copy {
		width: min(1280px, calc(100% - 4rem));
		margin: 0 auto;
		padding: 4rem 0 6rem;
		color: #fff;
	}

	.hero-eyebrow {
		margin: 0 0 1.25rem;
		color: #8dd0d9;
		font-size: 0.78rem;
		font-weight: 750;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 760px;
		margin: 0;
		font-size: clamp(3.2rem, 7vw, 6.6rem);
		font-weight: 700;
		line-height: 0.98;
		letter-spacing: -0.065em;
		text-wrap: balance;
	}

	.hero-brand {
		position: absolute;
		top: 2rem;
		right: max(2rem, calc((100% - 1280px) / 2));
		display: grid;
		padding: 0;
		place-items: center;
	}

	.hero-brand img {
		display: block;
		width: clamp(76px, 8vw, 112px);
		height: auto;
		filter: drop-shadow(0 2px 6px rgb(0 0 0 / 35%));
	}

	@media (max-width: 760px) {
		.hero {
			min-height: max(560px, calc(100svh - 184px));
			align-items: flex-end;
		}

		.hero::before {
			background: linear-gradient(
				0deg,
				rgb(37 43 55 / 92%) 0%,
				rgb(37 43 55 / 76%) 24%,
				rgb(37 43 55 / 38%) 48%,
				rgb(37 43 55 / 8%) 76%,
				transparent 100%
			);
		}

		.hero-image,
		.hero-video {
			width: 100%;
			object-position: center 25%;
		}

		.hero-copy {
			width: calc(100% - 2rem);
			padding: 3rem 0 3.5rem;
		}

		.hero-eyebrow {
			margin-bottom: 0.9rem;
			font-size: 0.68rem;
		}

		h1 {
			font-size: clamp(3rem, 12vw, 4.5rem);
		}

		.hero-brand {
			top: 1.2rem;
			right: 1rem;
		}

		.hero-brand img {
			width: clamp(72px, 20vw, 96px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-video {
			display: none;
		}

		.hero-image {
			display: block;
			transition: none;
		}
	}
</style>
